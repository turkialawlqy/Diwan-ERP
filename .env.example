APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Root domain of the platform; each company is served at {subdomain}.APP_DOMAIN
APP_DOMAIN=localhost
# Redirect tenant users from the central domain to their own subdomain (production)
TENANCY_ENFORCE_SUBDOMAIN=false
# Comma separated proxy IPs (or *) whose X-Forwarded-* headers are trusted
TRUSTED_PROXIES=
# Requests per minute on company routes
TENANCY_RATE_LIMIT_USER=300
TENANCY_RATE_LIMIT_COMPANY=3000
# ?tenant= / X-Tenant selection for local development (always ignored outside local/testing)
TENANCY_ALLOW_DEV_OVERRIDE=true
TENANCY_IMPERSONATION_MINUTES=60

# ZATCA e-invoicing (Fatoora portal); endpoints default to the official gateways
ZATCA_SOLUTION_NAME=Alostaz
ZATCA_SOLUTION_VERSION=ERP1
ZATCA_TIMEOUT=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: MySQL 8 (InnoDB, utf8mb4). For quick local development you may
# use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alostaz
DB_USERNAME=alostaz
DB_PASSWORD=

# Redis keeps sessions, cache, locks and queues off the main database.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Keep null so every company subdomain gets its own, unshared session cookie
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=alostaz_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
