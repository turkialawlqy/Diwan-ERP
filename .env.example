APP_NAME="الديوان"
APP_NAME_EN=Diwan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Business time zone: document dates, numbering years and reports follow it.
APP_TIMEZONE=Asia/Riyadh
# Redirect HTTP to HTTPS (defaults to on when APP_ENV=production; off for a LAN install over HTTP).
# FORCE_HTTPS=true
# Root domain of the platform; each company is served at {subdomain}.APP_DOMAIN
APP_DOMAIN=localhost
# Redirect tenant users from the central domain to their own subdomain (production)
TENANCY_ENFORCE_SUBDOMAIN=false
# Comma separated proxy IPs (or *) whose X-Forwarded-* headers are trusted
TRUSTED_PROXIES=
# Requests per minute on company routes
TENANCY_RATE_LIMIT_USER=300
TENANCY_RATE_LIMIT_COMPANY=3000
# ?tenant= / X-Tenant selection for local development (always ignored outside local/testing)
TENANCY_ALLOW_DEV_OVERRIDE=true
TENANCY_IMPERSONATION_MINUTES=60
# Reject requests for hosts that are not the platform, a company subdomain or a verified
# custom domain (defaults to on in production). Extra hosts allowed, comma separated.
# TENANCY_REJECT_UNKNOWN_HOSTS=true
TENANCY_ALLOWED_HOSTS=

# ZATCA e-invoicing (Fatoora portal); endpoints default to the official gateways
ZATCA_SOLUTION_NAME=Diwan
ZATCA_SOLUTION_VERSION=ERP1
ZATCA_TIMEOUT=30

APP_LOCALE=ar
# Show seeded demo accounts on the login page (local demos only).
DEMO_LOGIN=false
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: MySQL 8 (InnoDB, utf8mb4). For quick local development you may
# use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diwan
DB_USERNAME=diwan
DB_PASSWORD=

# Redis keeps sessions, cache, locks and queues off the main database.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Keep null so every company subdomain gets its own, unshared session cookie
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=diwan_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PDF documents (mPDF). Optional custom Arabic font in resources/fonts.
PDF_FONT=xbriyaz
PDF_FONT_FILE=
# Days a link sent to a customer (PDF / account statement) stays valid.
DOCUMENT_LINK_DAYS=30

# Two-factor authentication is mandatory for platform admins (set false only for local demos).
TWO_FACTOR_SUPER_ADMIN=true

# Encrypted backups (erp:backup). Keep the password outside the server.
BACKUP_PASSWORD=
BACKUP_DISK=backups
BACKUP_VERIFY_DATABASE=
BACKUP_NOTIFY_EMAIL=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Full path to mysqldump / mysql when they are not on PATH (e.g. MAMP on Windows).
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql
# Copy every backup off the server: BACKUP_OFFSITE_DISK=offsite + an S3-compatible bucket.
BACKUP_OFFSITE_DISK=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=me-south-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

# /health (uptime monitor): backup and scheduler checks default to on in production.
# HEALTH_CHECK_OPERATIONS=true
HEALTH_BACKUP_MAX_HOURS=26

# The platform as seller on subscription tax invoices, and the account customers pay into.
PLATFORM_LEGAL_NAME=
PLATFORM_TAX_NUMBER=
PLATFORM_CR=
PLATFORM_ADDRESS=
PLATFORM_BILLING_EMAIL=
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_IBAN=

# Windows auto-update: branch to follow (deploy/windows/update.ps1).
# UPDATE_BRANCH=claude/vigilant-cerf-uwqevd
