# Windows + MAMP (a company's own server on the office network).
# Copy to .env, then: php artisan key:generate, and run deploy\windows\update.bat
# and deploy\windows\install-auto-update.bat (as administrator).
APP_NAME="الديوان"
APP_NAME_EN=Diwan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_DOMAIN=localhost
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
# Plain HTTP on the office network: no HTTPS redirect, no secure-only cookie.
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
# Reached by IP / computer name on the LAN.
TENANCY_REJECT_UNKNOWN_HOSTS=false
TENANCY_ENFORCE_SUBDOMAIN=false
TENANCY_ALLOW_DEV_OVERRIDE=false
DEMO_LOGIN=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diwan
DB_USERNAME=root
DB_PASSWORD=root

# MAMP has no Redis: sessions, cache and queues in the database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Backups: required password (keep it outside this computer).
BACKUP_PASSWORD=
BACKUP_MYSQLDUMP='C:\MAMP\bin\mysql\bin\mysqldump.exe'
BACKUP_MYSQL='C:\MAMP\bin\mysql\bin\mysql.exe'
BACKUP_NOTIFY_EMAIL=

# Branch the auto-update follows.
UPDATE_BRANCH=claude/vigilant-cerf-uwqevd

HEALTH_CHECK_OPERATIONS=true
VITE_APP_NAME="${APP_NAME}"
