# Production server (Linux, SaaS). Copy to .env, fill every empty value,
# then: php artisan key:generate && php artisan migrate --force --seed &&
# php artisan erp:create-super-admin you@example.com && php artisan erp:preflight
APP_NAME="الديوان"
APP_NAME_EN=Diwan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://diwan.io
APP_DOMAIN=diwan.io
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
FORCE_HTTPS=true
DEMO_LOGIN=false

TENANCY_ENFORCE_SUBDOMAIN=true
TENANCY_ALLOW_DEV_OVERRIDE=false
TENANCY_REJECT_UNKNOWN_HOSTS=true
TENANCY_ALLOWED_HOSTS=
TRUSTED_PROXIES=
TENANCY_RATE_LIMIT_USER=300
TENANCY_RATE_LIMIT_COMPANY=3000
TENANCY_IMPERSONATION_MINUTES=60
TWO_FACTOR_SUPER_ADMIN=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diwan
DB_USERNAME=diwan
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=diwan_
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# A real mailer: email verification, password resets, alerts and invoices depend on it.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@diwan.io
MAIL_FROM_NAME="${APP_NAME}"

ZATCA_SOLUTION_NAME=Diwan
ZATCA_SOLUTION_VERSION=ERP1
ZATCA_TIMEOUT=30

# Backups are refused without a password in production. Keep it in a password manager.
BACKUP_PASSWORD=
BACKUP_DISK=backups
BACKUP_NOTIFY_EMAIL=
BACKUP_OFFSITE_DISK=offsite
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=me-south-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

HEALTH_CHECK_OPERATIONS=true
HEALTH_BACKUP_MAX_HOURS=26

PDF_FONT=xbriyaz
DOCUMENT_LINK_DAYS=30
VITE_APP_NAME="${APP_NAME}"

# The platform as seller on subscription tax invoices, and the account customers pay into.
PLATFORM_LEGAL_NAME=
PLATFORM_TAX_NUMBER=
PLATFORM_CR=
PLATFORM_ADDRESS=
PLATFORM_BILLING_EMAIL=
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_IBAN=
