# «الديوان» on a single server: the platform on __DOMAIN__ and every company on *.__DOMAIN__.
# Generated by deploy/ubuntu/install.sh (__MODE__).
__HTTP_BLOCK__

server {
    __LISTEN__
    server_name __DOMAIN__ *.__DOMAIN__;
    root __APP_DIR__/public;
    index index.php;
__SSL_LINES__
    client_max_body_size 20m;
    charset utf-8;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:__PHP_SOCK__;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 120;
    }

    location ~* \.(?:css|js|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known) { deny all; }
}
